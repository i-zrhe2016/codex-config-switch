#!/usr/bin/env python3
"""Rebind local Codex sessions to the provider selected by the current config."""

from __future__ import annotations

import json
import select
import shutil
import subprocess
import sys
from typing import Any, NoReturn

READ_TIMEOUT_SECONDS = 30
PAGE_SIZE = 200


class SessionSyncError(RuntimeError):
    pass


def fail(message: str) -> NoReturn:
    raise SessionSyncError(message)


class AppServer:
    def __init__(self) -> None:
        codex = shutil.which("codex")
        if not codex:
            fail("codex is required to synchronize sessions")
        try:
            self.process = subprocess.Popen(
                [codex, "app-server", "--stdio"],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                bufsize=0,
            )
        except OSError as exc:
            fail(f"cannot start codex app-server: {exc}")
        self.next_request_id = 1

    def close(self) -> None:
        process = self.process
        try:
            if process.stdin and not process.stdin.closed:
                process.stdin.close()
        except OSError:
            pass
        if process.poll() is None:
            process.terminate()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=5)

    def send(self, method: str, params: dict[str, Any] | None = None) -> int:
        request_id = self.next_request_id
        self.next_request_id += 1
        request: dict[str, Any] = {"id": request_id, "method": method}
        if params is not None:
            request["params"] = params
        if not self.process.stdin:
            fail("codex app-server stdin is unavailable")
        try:
            payload = (json.dumps(request, ensure_ascii=False) + "\n").encode("utf-8")
            self.process.stdin.write(payload)
            self.process.stdin.flush()
        except OSError as exc:
            fail(f"cannot send app-server request: {exc}")
        return request_id

    def notify(self, method: str) -> None:
        if not self.process.stdin:
            fail("codex app-server stdin is unavailable")
        try:
            self.process.stdin.write(
                (json.dumps({"method": method}) + "\n").encode("utf-8")
            )
            self.process.stdin.flush()
        except OSError as exc:
            fail(f"cannot send app-server notification: {exc}")

    def wait_for(self, request_id: int) -> dict[str, Any]:
        if not self.process.stdout:
            fail("codex app-server stdout is unavailable")
        stream = self.process.stdout
        while True:
            ready, _, _ = select.select([stream], [], [], READ_TIMEOUT_SECONDS)
            if not ready:
                fail("timed out waiting for codex app-server response")
            line = stream.readline()
            if not line:
                fail("codex app-server closed before returning a response")
            try:
                message = json.loads(line.decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError):
                continue
            if not isinstance(message, dict) or message.get("id") != request_id:
                continue
            error = message.get("error")
            if isinstance(error, dict):
                fail(str(error.get("message", "codex app-server request failed")))
            result = message.get("result")
            return result if isinstance(result, dict) else {}

    def request(self, method: str, params: dict[str, Any] | None = None) -> dict[str, Any]:
        return self.wait_for(self.send(method, params))


def initialize(server: AppServer) -> None:
    server.request(
        "initialize",
        {
            "clientInfo": {
                "name": "codex-session-sync",
                "title": "Codex Session Sync",
                "version": "0.1.0",
            }
        },
    )
    server.notify("initialized")


def current_target(server: AppServer) -> tuple[str, str | None]:
    result = server.request("config/read", {"includeLayers": False, "cwd": None})
    config = result.get("config")
    if not isinstance(config, dict):
        fail("codex app-server returned an invalid config")

    provider = config.get("model_provider")
    provider = provider if isinstance(provider, str) and provider else "openai"
    model = config.get("model")
    model = model if isinstance(model, str) and model else None
    if model:
        return provider, model

    cursor: str | None = None
    seen_cursors: set[str] = set()
    while True:
        params: dict[str, Any] = {"includeHidden": True, "limit": PAGE_SIZE}
        if cursor:
            params["cursor"] = cursor
        page = server.request("model/list", params)
        models = page.get("data")
        if isinstance(models, list):
            for item in models:
                if not isinstance(item, dict) or item.get("isDefault") is not True:
                    continue
                candidate = item.get("model")
                if isinstance(candidate, str) and candidate:
                    return provider, candidate
        next_cursor = page.get("nextCursor")
        if not isinstance(next_cursor, str) or not next_cursor or next_cursor in seen_cursors:
            break
        seen_cursors.add(next_cursor)
        cursor = next_cursor
    return provider, None


def list_threads(server: AppServer, archived: bool) -> list[dict[str, Any]]:
    params: dict[str, Any] = {
        "archived": archived,
        "limit": PAGE_SIZE,
        "modelProviders": [],
        "sortKey": "recency_at",
        "sortDirection": "desc",
        "useStateDbOnly": True,
    }
    threads: list[dict[str, Any]] = []
    seen_cursors: set[str] = set()
    while True:
        result = server.request("thread/list", params)
        page = result.get("data")
        if not isinstance(page, list):
            fail("codex app-server returned an invalid session list")
        threads.extend(item for item in page if isinstance(item, dict))
        cursor = result.get("nextCursor")
        if not isinstance(cursor, str) or not cursor or cursor in seen_cursors:
            break
        seen_cursors.add(cursor)
        params["cursor"] = cursor
    return threads


def all_threads(server: AppServer) -> list[dict[str, Any]]:
    result: list[dict[str, Any]] = []
    seen_ids: set[str] = set()
    for archived in (False, True):
        for thread in list_threads(server, archived):
            thread_id = thread.get("id")
            if not isinstance(thread_id, str) or not thread_id or thread_id in seen_ids:
                continue
            seen_ids.add(thread_id)
            result.append(thread)
    return result


def sync_thread(server: AppServer, thread_id: str, provider: str, model: str | None) -> None:
    params: dict[str, Any] = {
        "threadId": thread_id,
        "modelProvider": provider,
        "excludeTurns": True,
    }
    if model:
        params["model"] = model
    server.request("thread/resume", params)
    try:
        server.request("thread/unsubscribe", {"threadId": thread_id})
    except SessionSyncError:
        # Closing app-server also releases the local writer. Unsubscribe is only
        # an eager cleanup optimization.
        pass


def run() -> int:
    server = AppServer()
    try:
        initialize(server)
        provider, model = current_target(server)
        threads = all_threads(server)

        synced = 0
        already = 0
        active = 0
        failed = 0
        for thread in threads:
            thread_id = thread.get("id")
            if not isinstance(thread_id, str) or not thread_id:
                continue
            if thread.get("modelProvider") == provider:
                already += 1
                continue
            try:
                sync_thread(server, thread_id, provider, model)
                synced += 1
            except SessionSyncError as exc:
                if "active writer" in str(exc).casefold():
                    active += 1
                    continue
                failed += 1
                print(f"Warning: could not sync session {thread_id}: {exc}", file=sys.stderr)

        print(f"session_provider: {provider}")
        print(f"session_model: {model or '(provider default)'}")
        print(f"sessions_total: {len(threads)}")
        print(f"sessions_synced: {synced}")
        print(f"sessions_already_current: {already}")
        print(f"sessions_active_skipped: {active}")
        print(f"sessions_failed: {failed}")
        return 1 if failed else 0
    finally:
        server.close()


def main() -> int:
    try:
        return run()
    except SessionSyncError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
