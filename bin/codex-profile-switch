#!/usr/bin/env bash
set -euo pipefail
umask 077

CODEX_HOME="${CODEX_HOME:-/root/.codex}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SESSION_LIST_SCRIPT="${CODEX_SESSION_LIST_SCRIPT:-$SCRIPT_DIR/codex-session-list}"
SESSION_SYNC_SCRIPT="${CODEX_SESSION_SYNC_SCRIPT:-$SCRIPT_DIR/codex-session-sync}"
CONFIG_FILE="$CODEX_HOME/config.toml"
API_CONFIG="$CODEX_HOME/profiles/api/config.toml"
BACKUPS_DIR="$CODEX_HOME/profiles/backups"

usage() {
  cat <<'USAGE'
Usage:
  codex-profile-switch
  codex-profile-switch status|list|sessions|sync-sessions
  codex-profile-switch save api
  codex-profile-switch import api CONFIG_FILE
  codex-profile-switch use official|api [--no-sync-sessions]
  codex-profile-switch use official|api [--no-sync-sessions] --resume [CODEX_RESUME_ARGS...]
  codex-profile-switch use official|api [--no-sync-sessions] --resume-all [--last|SESSION_ID]

Switching profiles synchronizes inactive historical sessions to the newly active provider by default.
API keys are supplied through exported environment variables, not auth.json.
USAGE
}

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }
warn() { printf 'Warning: %s\n' "$*" >&2; }

ensure_dirs() {
  mkdir -p "$(dirname "$API_CONFIG")" "$BACKUPS_DIR"
  chmod 700 "$CODEX_HOME/profiles" "$(dirname "$API_CONFIG")" "$BACKUPS_DIR"
}

require_profile() {
  [[ "${1:-}" == official || "${1:-}" == api ]] || die "profile must be 'official' or 'api'"
}

require_codex() {
  command -v codex >/dev/null 2>&1 || die "codex is required"
}

require_session_list() {
  require_codex
  [[ -x "$SESSION_LIST_SCRIPT" ]] || die "session list helper is not executable: $SESSION_LIST_SCRIPT"
}

require_session_sync() {
  require_codex
  command -v python3 >/dev/null 2>&1 || die "python3 is required to synchronize sessions"
  [[ -f "$SESSION_SYNC_SCRIPT" ]] || die "session sync helper not found: $SESSION_SYNC_SCRIPT"
}

active_profile() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    printf 'official'
  elif [[ -f "$API_CONFIG" ]] && cmp -s "$CONFIG_FILE" "$API_CONFIG"; then
    printf 'api'
  else
    printf 'custom'
  fi
}

show_list() {
  printf 'official: built-in (auth untouched)\n'
  [[ -f "$API_CONFIG" ]] && printf 'api: complete\n' || printf 'api: missing config.toml\n'
}

show_status() {
  printf 'codex_home: %s\n' "$CODEX_HOME"
  printf 'active_profile: %s\n' "$(active_profile)"
  show_list
}

backup_config() {
  local dir
  [[ -f "$CONFIG_FILE" ]] || return 0
  dir="$(mktemp -d "$BACKUPS_DIR/$(date +%Y%m%d-%H%M%S).XXXXXX")"
  cp "$CONFIG_FILE" "$dir/config.toml"
  chmod 600 "$dir/config.toml"
  printf '%s\n' "$dir"
}

save_api() {
  [[ -f "$CONFIG_FILE" ]] || die "current config.toml does not exist"
  ensure_dirs
  cp "$CONFIG_FILE" "$API_CONFIG"
  chmod 600 "$API_CONFIG"
  info "Saved API config.toml."
}

import_api() {
  local src="${1:-}"
  [[ -n "$src" ]] || die "usage: codex-profile-switch import api CONFIG_FILE"
  [[ -f "$src" ]] || die "config file not found: $src"
  ensure_dirs
  cp "$src" "$API_CONFIG"
  chmod 600 "$API_CONFIG"
  info "Imported API config.toml."
}

apply_profile() {
  local profile="$1" backup=""
  require_profile "$profile"
  ensure_dirs

  if [[ "$profile" == api && ! -f "$API_CONFIG" ]]; then
    die "API config missing; run: codex-profile-switch import api CONFIG_FILE"
  fi

  backup="$(backup_config)"
  if [[ "$profile" == api ]]; then
    cp "$API_CONFIG" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
  else
    rm -f "$CONFIG_FILE"
  fi

  info "Switched to $profile profile."
  [[ -z "$backup" ]] || info "Backup: $backup"
}

sync_sessions() {
  require_session_sync
  python3 "$SESSION_SYNC_SCRIPT"
}

sync_after_switch() {
  if ! sync_sessions; then
    warn "profile switched, but one or more historical sessions could not be synchronized"
  fi
}

resume_all() {
  local selector="${1:-}" session_id
  [[ "$#" -le 1 ]] || die "--resume-all accepts --last or one session ID"
  [[ "$selector" != -* || "$selector" == --last ]] || die "unexpected argument: $selector"

  if [[ "$selector" == --last ]]; then
    session_id="$($SESSION_LIST_SCRIPT --last)"
  elif [[ -n "$selector" ]]; then
    session_id="$($SESSION_LIST_SCRIPT --id "$selector")"
  else
    session_id="$($SESSION_LIST_SCRIPT --select)"
  fi

  [[ -n "$session_id" ]] || die "no session was selected"
  exec codex resume "$session_id"
}

use_profile() {
  local profile="${1:-}" sync=true
  require_profile "$profile"
  shift

  if [[ "${1:-}" == --no-sync-sessions ]]; then
    sync=false
    shift
  fi

  case "${1:-}" in
    --resume)
      shift
      require_codex
      apply_profile "$profile"
      [[ "$sync" == false ]] || sync_after_switch
      exec codex resume "$@"
      ;;
    --resume-all)
      shift
      require_session_list
      apply_profile "$profile"
      [[ "$sync" == false ]] || sync_after_switch
      resume_all "$@"
      ;;
    "")
      apply_profile "$profile"
      [[ "$sync" == false ]] || sync_after_switch
      ;;
    *) die "unexpected argument: $1" ;;
  esac
}

interactive_main() {
  local choice path
  cat <<'MENU'
Codex config switcher
  1) Use official login + sync sessions
  2) Use API config + sync sessions
  3) Status
  4) Save current config as API
  5) Import API config
  6) List sessions
  7) Sync sessions to current provider
  0) Exit
MENU
  printf 'Choose [0-7]: '
  IFS= read -r choice
  case "$choice" in
    1) use_profile official ;;
    2) use_profile api ;;
    3) show_status ;;
    4) save_api ;;
    5) printf 'config.toml path: '; IFS= read -r path; import_api "$path" ;;
    6) require_session_list; "$SESSION_LIST_SCRIPT" ;;
    7) sync_sessions ;;
    0) : ;;
    *) die "invalid choice" ;;
  esac
}

main() {
  ensure_dirs
  case "${1:-}" in
    status) show_status ;;
    list) show_list ;;
    sessions) require_session_list; "$SESSION_LIST_SCRIPT" ;;
    sync-sessions) sync_sessions ;;
    save) [[ "${2:-}" == api ]] || die "only API config.toml is saved"; save_api ;;
    import) [[ "${2:-}" == api ]] || die "only API config.toml is imported"; import_api "${3:-}" ;;
    use) shift; use_profile "$@" ;;
    -h|--help|help) usage ;;
    "") [[ -t 0 ]] || die "no command provided"; interactive_main ;;
    *) usage >&2; exit 1 ;;
  esac
}

main "$@"
